rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isValidId(id) {
      return id is string
        && id.size() >= 1
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSlug(slug) {
      return slug is string
        && slug.size() >= 2
        && slug.size() <= 80
        && slug.matches('^[a-z0-9\\-]+$');
    }

    function isValidKey(key) {
      return key is string
        && key.size() >= 2
        && key.size() <= 10
        && key.matches('^[A-Z0-9]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    // Bootstrap admin without DB read (safe for allow list checks)
    function isBootstrapAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'harshuljain923@gmail.com';
    }

    // Full platform admin (never granted automatically to workspace admins)
    function isAdmin() {
      return isBootstrapAdmin()
        || (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // Master Gate Workspace Helpers (for get/create/update/delete, never inside allow list)
    function memberDoc(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
    }

    function isWorkspaceMember(workspaceId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
    }

    function isWorkspaceOwner(workspaceId) {
      return isWorkspaceMember(workspaceId) && memberDoc(workspaceId).data.role == 'owner';
    }

    function isWorkspaceManager(workspaceId) {
      return isWorkspaceMember(workspaceId)
        && memberDoc(workspaceId).data.role in ['owner', 'admin'];
    }

    function isWorkspaceContributor(workspaceId) {
      return isWorkspaceMember(workspaceId)
        && memberDoc(workspaceId).data.role in ['owner', 'admin', 'member'];
    }

    function isValidBoundedIdList(listVal, maxItems) {
      return listVal is list
        && listVal.size() <= maxItems
        && (listVal.size() == 0 || (listVal[0] is string && listVal[0].size() <= 128));
    }

    function isValidLabelList(listVal) {
      return listVal is list
        && listVal.size() <= 10
        && (listVal.size() == 0 || (listVal[0] is string && listVal[0].size() <= 32));
    }

    // Entity Validation Blueprints
    function isValidPublicProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'jobTitle', 'bio', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 100
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && (!('jobTitle' in data) || (data.jobTitle is string && data.jobTitle.size() <= 80))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 300))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'notifyTaskAssigned', 'notifyComments', 'notifyDeadlines', 'themePreference', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && (!('notifyTaskAssigned' in data) || data.notifyTaskAssigned is bool)
        && (!('notifyComments' in data) || data.notifyComments is bool)
        && (!('notifyDeadlines' in data) || data.notifyDeadlines is bool)
        && (!('themePreference' in data) || data.themePreference in ['light', 'dark', 'system'])
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWorkspaceRef(data, userId, workspaceId) {
      return data.keys().hasAll(['workspaceId', 'userId', 'workspaceName', 'workspaceSlug', 'role', 'joinedAt', 'updatedAt'])
        && data.keys().hasOnly(['workspaceId', 'userId', 'workspaceName', 'workspaceSlug', 'role', 'joinedAt', 'updatedAt'])
        && isValidId(data.workspaceId)
        && data.workspaceId == workspaceId
        && isValidId(data.userId)
        && data.userId == userId
        && data.workspaceName is string
        && data.workspaceName.size() >= 1
        && data.workspaceName.size() <= 80
        && isValidSlug(data.workspaceSlug)
        && data.role in ['owner', 'admin', 'member', 'viewer']
        && data.joinedAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWorkspace(data, workspaceId) {
      return data.keys().hasAll(['id', 'name', 'slug', 'ownerId', 'defaultTaskStatus', 'allowViewerComments', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'slug', 'description', 'ownerId', 'defaultTaskStatus', 'allowViewerComments', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.id == workspaceId
        && data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 80
        && isValidSlug(data.slug)
        && (!('description' in data) || (data.description is string && data.description.size() <= 300))
        && isValidId(data.ownerId)
        && data.defaultTaskStatus in ['backlog', 'todo', 'in_progress', 'in_review', 'done']
        && data.allowViewerComments is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWorkspaceMember(data, workspaceId, memberId) {
      return data.keys().hasAll(['workspaceId', 'userId', 'displayName', 'role', 'status', 'visibleMemberIds', 'joinedAt', 'updatedAt'])
        && data.keys().hasOnly(['workspaceId', 'userId', 'displayName', 'photoURL', 'role', 'status', 'invitationId', 'visibleMemberIds', 'joinedAt', 'updatedAt'])
        && isValidId(data.workspaceId)
        && data.workspaceId == workspaceId
        && isValidId(data.userId)
        && data.userId == memberId
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 100
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && (!('invitationId' in data) || isValidId(data.invitationId))
        && data.role in ['owner', 'admin', 'member', 'viewer']
        && data.status == 'active'
        && isValidBoundedIdList(data.visibleMemberIds, 25)
        && data.joinedAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidInvitation(data, workspaceId, invitationId) {
      return data.keys().hasAll(['id', 'workspaceId', 'workspaceName', 'workspaceSlug', 'workspaceOwnerId', 'email', 'role', 'invitedBy', 'invitedByName', 'status', 'expiresAt', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'workspaceId', 'workspaceName', 'workspaceSlug', 'workspaceOwnerId', 'email', 'role', 'invitedBy', 'invitedByName', 'status', 'expiresAt', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.id == invitationId
        && isValidId(data.workspaceId)
        && data.workspaceId == workspaceId
        && data.workspaceName is string
        && data.workspaceName.size() >= 1
        && data.workspaceName.size() <= 80
        && isValidSlug(data.workspaceSlug)
        && isValidId(data.workspaceOwnerId)
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.role in ['admin', 'member', 'viewer']
        && isValidId(data.invitedBy)
        && data.invitedByName is string
        && data.invitedByName.size() >= 1
        && data.invitedByName.size() <= 100
        && data.status in ['pending', 'accepted', 'revoked']
        && data.expiresAt is timestamp
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProject(data, workspaceId, projectId) {
      return data.keys().hasAll(['id', 'workspaceId', 'name', 'description', 'key', 'status', 'visibility', 'ownerId', 'memberIds', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'workspaceId', 'name', 'description', 'key', 'status', 'visibility', 'ownerId', 'memberIds', 'startDate', 'dueDate', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.id == projectId
        && isValidId(data.workspaceId)
        && data.workspaceId == workspaceId
        && data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 100
        && data.description is string
        && data.description.size() <= 1000
        && isValidKey(data.key)
        && data.status in ['planning', 'active', 'on_hold', 'completed', 'archived']
        && data.visibility in ['workspace', 'private']
        && isValidId(data.ownerId)
        && isValidBoundedIdList(data.memberIds, 25)
        && (!('startDate' in data) || (data.startDate is string && data.startDate.size() <= 32))
        && (!('dueDate' in data) || (data.dueDate is string && data.dueDate.size() <= 32))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTask(data, workspaceId, taskId) {
      return data.keys().hasAll(['id', 'workspaceId', 'projectId', 'title', 'description', 'status', 'priority', 'assigneeIds', 'reporterId', 'projectMemberIds', 'labels', 'position', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'workspaceId', 'projectId', 'title', 'description', 'status', 'priority', 'assigneeIds', 'reporterId', 'projectMemberIds', 'labels', 'startDate', 'dueDate', 'position', 'parentTaskId', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.id == taskId
        && isValidId(data.workspaceId)
        && data.workspaceId == workspaceId
        && isValidId(data.projectId)
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 180
        && data.description is string
        && data.description.size() <= 4000
        && data.status in ['backlog', 'todo', 'in_progress', 'in_review', 'done']
        && data.priority in ['low', 'medium', 'high', 'urgent']
        && isValidBoundedIdList(data.assigneeIds, 10)
        && isValidId(data.reporterId)
        && isValidBoundedIdList(data.projectMemberIds, 25)
        && isValidLabelList(data.labels)
        && (!('startDate' in data) || (data.startDate is string && data.startDate.size() <= 32))
        && (!('dueDate' in data) || (data.dueDate is string && data.dueDate.size() <= 32))
        && data.position is number
        && data.position >= 0
        && (!('parentTaskId' in data) || (data.parentTaskId is string && data.parentTaskId.size() <= 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSubtask(data, workspaceId, taskId, subtaskId) {
      return data.keys().hasAll(['id', 'workspaceId', 'projectId', 'taskId', 'title', 'completed', 'createdBy', 'projectMemberIds', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'workspaceId', 'projectId', 'taskId', 'title', 'completed', 'createdBy', 'projectMemberIds', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.id == subtaskId
        && isValidId(data.workspaceId)
        && data.workspaceId == workspaceId
        && isValidId(data.projectId)
        && isValidId(data.taskId)
        && data.taskId == taskId
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 180
        && data.completed is bool
        && isValidId(data.createdBy)
        && isValidBoundedIdList(data.projectMemberIds, 25)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidComment(data, workspaceId, taskId, commentId) {
      return data.keys().hasAll(['id', 'workspaceId', 'projectId', 'taskId', 'authorId', 'authorName', 'content', 'mentions', 'projectMemberIds', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'workspaceId', 'projectId', 'taskId', 'authorId', 'authorName', 'authorPhotoURL', 'content', 'mentions', 'projectMemberIds', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.id == commentId
        && isValidId(data.workspaceId)
        && data.workspaceId == workspaceId
        && isValidId(data.projectId)
        && isValidId(data.taskId)
        && data.taskId == taskId
        && isValidId(data.authorId)
        && data.authorName is string
        && data.authorName.size() >= 1
        && data.authorName.size() <= 100
        && (!('authorPhotoURL' in data) || (data.authorPhotoURL is string && data.authorPhotoURL.size() <= 500))
        && data.content is string
        && data.content.size() >= 1
        && data.content.size() <= 2000
        && isValidBoundedIdList(data.mentions, 10)
        && isValidBoundedIdList(data.projectMemberIds, 25)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAttachment(data, workspaceId, taskId, attachmentId) {
      return data.keys().hasAll(['id', 'workspaceId', 'projectId', 'taskId', 'uploadedBy', 'uploadedByName', 'fileName', 'mimeType', 'fileSize', 'contentData', 'projectMemberIds', 'createdAt'])
        && data.keys().hasOnly(['id', 'workspaceId', 'projectId', 'taskId', 'uploadedBy', 'uploadedByName', 'fileName', 'mimeType', 'fileSize', 'contentData', 'projectMemberIds', 'createdAt'])
        && isValidId(data.id)
        && data.id == attachmentId
        && isValidId(data.workspaceId)
        && data.workspaceId == workspaceId
        && isValidId(data.projectId)
        && isValidId(data.taskId)
        && data.taskId == taskId
        && isValidId(data.uploadedBy)
        && data.uploadedByName is string
        && data.uploadedByName.size() >= 1
        && data.uploadedByName.size() <= 100
        && data.fileName is string
        && data.fileName.size() >= 1
        && data.fileName.size() <= 160
        && data.mimeType in ['image/png', 'image/jpeg', 'image/webp', 'application/pdf', 'text/plain', 'text/markdown', 'application/json', 'text/csv']
        && data.fileSize is number
        && data.fileSize > 0
        && data.fileSize <= 204800
        && data.contentData is string
        && data.contentData.size() >= 1
        && data.contentData.size() <= 300000
        && isValidBoundedIdList(data.projectMemberIds, 25)
        && data.createdAt is timestamp;
    }

    function isValidNotification(data, userId, notificationId) {
      return data.keys().hasAll(['id', 'workspaceId', 'userId', 'type', 'title', 'message', 'entityType', 'entityId', 'read', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'workspaceId', 'userId', 'type', 'title', 'message', 'entityType', 'entityId', 'read', 'createdBy', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.id == notificationId
        && isValidId(data.workspaceId)
        && isValidId(data.userId)
        && data.userId == userId
        && data.type in ['task_assigned', 'task_updated', 'deadline_approaching', 'task_overdue', 'comment_received', 'mention_received', 'workspace_invitation']
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 120
        && data.message is string
        && data.message.size() >= 1
        && data.message.size() <= 300
        && data.entityType in ['task', 'project', 'workspace', 'comment']
        && isValidId(data.entityId)
        && data.read is bool
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidActivityLog(data, workspaceId, logId) {
      return data.keys().hasAll(['id', 'workspaceId', 'actorId', 'actorName', 'entityType', 'entityId', 'action', 'summary', 'memberIds', 'createdAt'])
        && data.keys().hasOnly(['id', 'workspaceId', 'actorId', 'actorName', 'entityType', 'entityId', 'action', 'summary', 'memberIds', 'createdAt'])
        && isValidId(data.id)
        && data.id == logId
        && isValidId(data.workspaceId)
        && data.workspaceId == workspaceId
        && isValidId(data.actorId)
        && data.actorName is string
        && data.actorName.size() >= 1
        && data.actorName.size() <= 100
        && data.entityType in ['workspace', 'member', 'invitation', 'project', 'task', 'comment', 'attachment']
        && isValidId(data.entityId)
        && data.action is string
        && data.action.size() >= 1
        && data.action.size() <= 60
        && data.summary is string
        && data.summary.size() >= 1
        && data.summary.size() <= 240
        && isValidBoundedIdList(data.memberIds, 25)
        && data.createdAt is timestamp;
    }

    // Platform Admin Registry
    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isBootstrapAdmin();
      allow create, update, delete: if isBootstrapAdmin();
    }

    // User Public Profiles (no PII)
    match /users/{userId}/public/profile {
      allow get: if isValidId(userId) && isSignedIn();
      allow list: if false;

      allow create: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidPublicProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidPublicProfile(incoming(), userId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'jobTitle', 'bio', 'updatedAt'])
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if false;
    }

    // User Private Info & Preferences (PII strictly isolated)
    match /users/{userId}/private/info {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;

      allow create: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidPrivateInfo(incoming(), userId)
        && incoming().email == request.auth.token.email
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidPrivateInfo(incoming(), userId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'notifyTaskAssigned', 'notifyComments', 'notifyDeadlines', 'themePreference', 'updatedAt'])
        && incoming().email == request.auth.token.email
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if false;
    }

    // User Workspace Membership Refs (powers member workspace list without get() in allow list)
    match /users/{userId}/workspaceRefs/{workspaceId} {
      allow get: if isValidId(userId) && isValidId(workspaceId) && (isOwner(userId) || isAdmin());
      allow list: if isOwner(userId) || isBootstrapAdmin();

      allow create: if isValidId(userId)
        && isValidId(workspaceId)
        && isVerifiedUser()
        && isValidWorkspaceRef(incoming(), userId, workspaceId)
        && incoming().joinedAt == request.time
        && incoming().updatedAt == request.time
        && (isOwner(userId) || isWorkspaceManager(workspaceId))
        && existsAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(userId));

      allow update: if isValidId(userId)
        && isValidId(workspaceId)
        && isVerifiedUser()
        && isValidWorkspaceRef(incoming(), userId, workspaceId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['workspaceName', 'workspaceSlug', 'role', 'updatedAt'])
        && incoming().workspaceId == existing().workspaceId
        && incoming().userId == existing().userId
        && incoming().joinedAt == existing().joinedAt
        && incoming().updatedAt == request.time
        && (isWorkspaceManager(workspaceId) || isOwner(userId));

      allow delete: if isValidId(userId)
        && isValidId(workspaceId)
        && isVerifiedUser()
        && (isOwner(userId) || isWorkspaceManager(workspaceId) || isAdmin());
    }

    // User Notification Inbox
    match /users/{userId}/notifications/{notificationId} {
      allow get: if isValidId(userId) && isValidId(notificationId) && isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if isValidId(userId)
        && isValidId(notificationId)
        && isVerifiedUser()
        && isValidNotification(incoming(), userId, notificationId)
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isValidId(notificationId)
        && isVerifiedOwner(userId)
        && isValidNotification(incoming(), userId, notificationId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['read', 'updatedAt'])
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if isValidId(userId) && isValidId(notificationId) && isOwner(userId);
    }

    // Collection-Group Query for Invitee Pending Invitations
    match /{path=**}/invitations/{invitationId} {
      allow list: if isVerifiedUser()
        && resource.data.email == request.auth.token.email;
    }

    // Workspaces
    match /workspaces/{workspaceId} {
      allow get: if isValidId(workspaceId) && (isWorkspaceMember(workspaceId) || isAdmin());
      allow list: if isBootstrapAdmin();

      allow create: if isValidId(workspaceId)
        && isVerifiedUser()
        && isValidWorkspace(incoming(), workspaceId)
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));

      allow update: if isValidId(workspaceId)
        && isVerifiedUser()
        && isValidWorkspace(incoming(), workspaceId)
        && (isWorkspaceManager(workspaceId) || isAdmin())
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'slug', 'description', 'defaultTaskStatus', 'allowViewerComments', 'updatedAt'])
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if isValidId(workspaceId)
        && isVerifiedUser()
        && (isWorkspaceOwner(workspaceId) || isAdmin());

      // Workspace Members (Authoritative Master Gate)
      match /members/{memberId} {
        allow get: if isValidId(workspaceId) && isValidId(memberId) && (isWorkspaceMember(workspaceId) || isAdmin());
        allow list: if isSignedIn() && (
          resource.data.userId == request.auth.uid
          || request.auth.uid in resource.data.visibleMemberIds
          || isBootstrapAdmin()
        );

        allow create: if isValidId(workspaceId)
          && isValidId(memberId)
          && isVerifiedUser()
          && isValidWorkspaceMember(incoming(), workspaceId, memberId)
          && incoming().joinedAt == request.time
          && incoming().updatedAt == request.time
          && (
            (memberId == request.auth.uid
              && incoming().role == 'owner'
              && getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid)
            || (memberId == request.auth.uid
              && 'invitationId' in incoming()
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)/invitations/$(incoming().invitationId)).data.status == 'pending'
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)/invitations/$(incoming().invitationId)).data.email == request.auth.token.email
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)/invitations/$(incoming().invitationId)).data.role == incoming().role
              && getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/invitations/$(incoming().invitationId)).data.status == 'accepted')
            || isWorkspaceManager(workspaceId)
          );

        allow update: if isValidId(workspaceId)
          && isValidId(memberId)
          && isVerifiedUser()
          && isValidWorkspaceMember(incoming(), workspaceId, memberId)
          && (
            (isWorkspaceManager(workspaceId)
              && memberId != get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId
              && incoming().role != 'owner'
              && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'visibleMemberIds', 'displayName', 'photoURL', 'updatedAt']))
            || (isWorkspaceMember(workspaceId)
              && incoming().role == existing().role
              && incoming().diff(existing()).affectedKeys().hasOnly(['visibleMemberIds', 'displayName', 'photoURL', 'updatedAt']))
          )
          && incoming().workspaceId == existing().workspaceId
          && incoming().userId == existing().userId
          && incoming().joinedAt == existing().joinedAt
          && incoming().updatedAt == request.time;

        allow delete: if isValidId(workspaceId)
          && isValidId(memberId)
          && isVerifiedUser()
          && (
            (isWorkspaceManager(workspaceId) && memberId != get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId)
            || (memberId == request.auth.uid && existing().role != 'owner')
            || isAdmin()
          );
      }

      // Workspace Invitations
      match /invitations/{invitationId} {
        allow get: if isValidId(workspaceId)
          && isValidId(invitationId)
          && (isWorkspaceManager(workspaceId) || (isVerifiedUser() && existing().email == request.auth.token.email) || isAdmin());

        allow list: if isSignedIn() && (
          resource.data.workspaceOwnerId == request.auth.uid
          || resource.data.invitedBy == request.auth.uid
          || (isVerifiedUser() && resource.data.email == request.auth.token.email)
          || isBootstrapAdmin()
        );

        allow create: if isValidId(workspaceId)
          && isValidId(invitationId)
          && isVerifiedUser()
          && isWorkspaceManager(workspaceId)
          && isValidInvitation(incoming(), workspaceId, invitationId)
          && incoming().invitedBy == request.auth.uid
          && incoming().status == 'pending'
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(workspaceId)
          && isValidId(invitationId)
          && isVerifiedUser()
          && isValidInvitation(incoming(), workspaceId, invitationId)
          && existing().status == 'pending'
          && incoming().id == existing().id
          && incoming().workspaceId == existing().workspaceId
          && incoming().email == existing().email
          && incoming().role == existing().role
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (isWorkspaceManager(workspaceId)
              && incoming().status == 'revoked'
              && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
            || (existing().email == request.auth.token.email
              && incoming().status == 'accepted'
              && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
              && existsAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)))
          );

        allow delete: if isValidId(workspaceId)
          && isValidId(invitationId)
          && isVerifiedUser()
          && (isWorkspaceManager(workspaceId) || isAdmin());
      }

      // Workspace Projects
      match /projects/{projectId} {
        allow get: if isValidId(workspaceId) && isValidId(projectId) && (isWorkspaceMember(workspaceId) || isAdmin());
        allow list: if isSignedIn() && (
          resource.data.ownerId == request.auth.uid
          || request.auth.uid in resource.data.memberIds
          || isBootstrapAdmin()
        );

        allow create: if isValidId(workspaceId)
          && isValidId(projectId)
          && isVerifiedUser()
          && isWorkspaceContributor(workspaceId)
          && isValidProject(incoming(), workspaceId, projectId)
          && incoming().ownerId == request.auth.uid
          && request.auth.uid in incoming().memberIds
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(workspaceId)
          && isValidId(projectId)
          && isVerifiedUser()
          && isWorkspaceContributor(workspaceId)
          && isValidProject(incoming(), workspaceId, projectId)
          && incoming().id == existing().id
          && incoming().workspaceId == existing().workspaceId
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'key', 'status', 'visibility', 'memberIds', 'startDate', 'dueDate', 'updatedAt'])
          && (isWorkspaceManager(workspaceId) || existing().ownerId == request.auth.uid || isAdmin());

        allow delete: if isValidId(workspaceId)
          && isValidId(projectId)
          && isVerifiedUser()
          && (isWorkspaceManager(workspaceId) || existing().ownerId == request.auth.uid || isAdmin());
      }

      // Workspace Tasks
      match /tasks/{taskId} {
        allow get: if isValidId(workspaceId) && isValidId(taskId) && (isWorkspaceMember(workspaceId) || isAdmin());
        allow list: if isSignedIn() && (
          resource.data.reporterId == request.auth.uid
          || request.auth.uid in resource.data.assigneeIds
          || request.auth.uid in resource.data.projectMemberIds
          || isBootstrapAdmin()
        );

        allow create: if isValidId(workspaceId)
          && isValidId(taskId)
          && isVerifiedUser()
          && isWorkspaceContributor(workspaceId)
          && isValidTask(incoming(), workspaceId, taskId)
          && exists(/databases/$(database)/documents/workspaces/$(workspaceId)/projects/$(incoming().projectId))
          && incoming().reporterId == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(workspaceId)
          && isValidId(taskId)
          && isVerifiedUser()
          && isWorkspaceContributor(workspaceId)
          && isValidTask(incoming(), workspaceId, taskId)
          && incoming().id == existing().id
          && incoming().workspaceId == existing().workspaceId
          && incoming().projectId == existing().projectId
          && incoming().reporterId == existing().reporterId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'status', 'priority', 'assigneeIds', 'projectMemberIds', 'labels', 'startDate', 'dueDate', 'position', 'parentTaskId', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['status', 'position', 'updatedAt'])
          );

        allow delete: if isValidId(workspaceId)
          && isValidId(taskId)
          && isVerifiedUser()
          && (isWorkspaceManager(workspaceId) || existing().reporterId == request.auth.uid || isAdmin());

        // Task Subtasks
        match /subtasks/{subtaskId} {
          allow get: if isValidId(workspaceId) && isValidId(taskId) && isValidId(subtaskId) && (isWorkspaceMember(workspaceId) || isAdmin());
          allow list: if isSignedIn() && (
            resource.data.createdBy == request.auth.uid
            || request.auth.uid in resource.data.projectMemberIds
            || isBootstrapAdmin()
          );

          allow create: if isValidId(workspaceId)
            && isValidId(taskId)
            && isValidId(subtaskId)
            && isVerifiedUser()
            && isWorkspaceContributor(workspaceId)
            && isValidSubtask(incoming(), workspaceId, taskId, subtaskId)
            && exists(/databases/$(database)/documents/workspaces/$(workspaceId)/tasks/$(taskId))
            && incoming().createdBy == request.auth.uid
            && incoming().createdAt == request.time
            && incoming().updatedAt == request.time;

          allow update: if isValidId(workspaceId)
            && isValidId(taskId)
            && isValidId(subtaskId)
            && isVerifiedUser()
            && isWorkspaceContributor(workspaceId)
            && isValidSubtask(incoming(), workspaceId, taskId, subtaskId)
            && incoming().id == existing().id
            && incoming().workspaceId == existing().workspaceId
            && incoming().taskId == existing().taskId
            && incoming().createdBy == existing().createdBy
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'completed', 'updatedAt']);

          allow delete: if isValidId(workspaceId)
            && isValidId(taskId)
            && isValidId(subtaskId)
            && isVerifiedUser()
            && isWorkspaceContributor(workspaceId);
        }

        // Task Comments
        match /comments/{commentId} {
          allow get: if isValidId(workspaceId) && isValidId(taskId) && isValidId(commentId) && (isWorkspaceMember(workspaceId) || isAdmin());
          allow list: if isSignedIn() && (
            resource.data.authorId == request.auth.uid
            || request.auth.uid in resource.data.projectMemberIds
            || isBootstrapAdmin()
          );

          allow create: if isValidId(workspaceId)
            && isValidId(taskId)
            && isValidId(commentId)
            && isVerifiedUser()
            && (
              isWorkspaceContributor(workspaceId)
              || (isWorkspaceMember(workspaceId) && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.allowViewerComments == true)
            )
            && isValidComment(incoming(), workspaceId, taskId, commentId)
            && exists(/databases/$(database)/documents/workspaces/$(workspaceId)/tasks/$(taskId))
            && incoming().authorId == request.auth.uid
            && incoming().createdAt == request.time
            && incoming().updatedAt == request.time;

          allow update: if isValidId(workspaceId)
            && isValidId(taskId)
            && isValidId(commentId)
            && isVerifiedUser()
            && isValidComment(incoming(), workspaceId, taskId, commentId)
            && existing().authorId == request.auth.uid
            && incoming().id == existing().id
            && incoming().workspaceId == existing().workspaceId
            && incoming().taskId == existing().taskId
            && incoming().authorId == existing().authorId
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['content', 'mentions', 'updatedAt']);

          allow delete: if isValidId(workspaceId)
            && isValidId(taskId)
            && isValidId(commentId)
            && isVerifiedUser()
            && (existing().authorId == request.auth.uid || isWorkspaceManager(workspaceId) || isAdmin());
        }

        // Task Attachments
        match /attachments/{attachmentId} {
          allow get: if isValidId(workspaceId) && isValidId(taskId) && isValidId(attachmentId) && (isWorkspaceMember(workspaceId) || isAdmin());
          allow list: if isSignedIn() && (
            resource.data.uploadedBy == request.auth.uid
            || request.auth.uid in resource.data.projectMemberIds
            || isBootstrapAdmin()
          );

          allow create: if isValidId(workspaceId)
            && isValidId(taskId)
            && isValidId(attachmentId)
            && isVerifiedUser()
            && isWorkspaceContributor(workspaceId)
            && isValidAttachment(incoming(), workspaceId, taskId, attachmentId)
            && exists(/databases/$(database)/documents/workspaces/$(workspaceId)/tasks/$(taskId))
            && incoming().uploadedBy == request.auth.uid
            && incoming().createdAt == request.time;

          allow update: if false;

          allow delete: if isValidId(workspaceId)
            && isValidId(taskId)
            && isValidId(attachmentId)
            && isVerifiedUser()
            && (existing().uploadedBy == request.auth.uid || isWorkspaceManager(workspaceId) || isAdmin());
        }
      }

      // Workspace Immutable Activity Logs
      match /activityLogs/{logId} {
        allow get: if isValidId(workspaceId) && isValidId(logId) && (isWorkspaceMember(workspaceId) || isAdmin());
        allow list: if isSignedIn() && (
          resource.data.actorId == request.auth.uid
          || request.auth.uid in resource.data.memberIds
          || isBootstrapAdmin()
        );

        allow create: if isValidId(workspaceId)
          && isValidId(logId)
          && isVerifiedUser()
          && (
            isWorkspaceContributor(workspaceId)
            || (
              incoming().entityType == 'workspace'
              && incoming().action == 'created'
              && getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data.role == 'owner'
            )
          )
          && isValidActivityLog(incoming(), workspaceId, logId)
          && incoming().actorId == request.auth.uid
          && incoming().createdAt == request.time;

        allow update, delete: if false;
      }
    }
  }
}
